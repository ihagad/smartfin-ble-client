' Green  = implemented
' Yellow = in progress
' Gray   = future work
@startuml Processing Pipeline
top to bottom direction

title Smartfin BLE Client\nBLE IMU stream to ocean wave statistics

skinparam nodesep 40
skinparam ranksep 60
skinparam defaultTextAlignment center

package "Transport" {
    [BLE / CoreBluetooth] as ble #Green
    [CoreBluetooth\n(Swift / watchOS)] as corebt #Green
}

package "Protocol" {
    [Ensemble Decoder] as decoder #Green
}

package "Orientation" {
    package "IMU without quaternion" {
        [Madgwick Filter\norient_from_imu] as ahrs #Green
    }

    package "IMU with quaternion" {
        [DMP Quaternion Rotate\norient_from_quat_imu\n(skips AHRS)] as quat_orient #Green
    }

    [Oriented Ride\n(time merge)] as oriented #Green
}

package "Processing" {
    [Decimator\n(factor 11, 65-tap FIR)] as dec #Green
    [Bandpass Filter\n(0.05-0.50 Hz, filtfilt)] as bp #Green
    [FFT\n(Cooley-Tukey)] as fft #Green
    [Welch PSD] as welch ##Green
    [Wave Metrics\n(Hs, Tp, Tm)] as metrics ##Green
}

package "Output" {
    [File Sink\n(.sfdat)] as sink #Green
    [Swift / watchOS API\n(C bridge)] as swift #Green
    [Python Demo\n(ctypes)] as demo #Green
}

ble --> decoder
corebt --> decoder
decoder --> ahrs : DecodedImu\n(accel, gyro, mag)
decoder --> quat_orient : DecodedQuatImu\n(accel, gyro, mag, q)
ahrs --> oriented : OrientedSample\n(q from AHRS)
quat_orient --> oriented : OrientedSample\n(q from packet)
oriented --> dec : Earth-frame\nacceleration
dec --> bp : Decimated\nsamples
bp --> fft : Filtered\nsignal
fft --> welch : Periodogram\nsegments
welch --> metrics : PSD
decoder --> sink : Decoded ensembles
metrics --> swift
metrics --> demo

@enduml
